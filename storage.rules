rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 문서 읽기는 모든 사용자에게 허용 (PDF 뷰어 CORS 문제 해결)
    // 쓰기는 인증된 사용자만 가능
    match /documents/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 임시 파일 (필요시)
    match /temp/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
